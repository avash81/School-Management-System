model Class {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  name       String
  shortName  String?   @map("short_name")
  educationLevel String? @map("education_level")
  minimumAge Int?      @map("minimum_age")
  maximumAge Int?      @map("maximum_age")
  orderIndex Int       @map("order_index")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  classId    String    @map("class_id")
  name       String
  capacity   Int?      @map("capacity")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([classId, name])
  @@index([schoolId])
  @@index([classId])
  @@map("sections")
}

model Subject {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  name       String
  shortName  String?   @map("short_name")
  code       String
  category   String
  maximumMarks Int?    @map("maximum_marks")
  credit     Int?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model SubjectGroup {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subject_groups")
}

model TeacherAssignment {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  teacherId   String    @map("teacher_id")
  academicYearId String @map("academic_year_id")
  classId     String    @map("class_id")
  sectionId   String    @map("section_id")
  subjectId   String    @map("subject_id")
  role        String    @default("subject_teacher")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([teacherId, academicYearId, classId, sectionId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@map("teacher_assignments")
}

model CurriculumVersion {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  name         String
  version      String
  description  String?
  isActive     Boolean   @default(false) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@unique([schoolId, name, version])
  @@index([schoolId])
  @@map("curriculum_versions")
}

model AssessmentBlueprint {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  curriculumVersionId String @map("curriculum_version_id")
  name        String
  subjectId   String?   @map("subject_id")
  totalMarks  Int       @map("total_marks")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([schoolId])
  @@index([subjectId])
  @@index([curriculumVersionId])
  @@map("assessment_blueprints")
}

model AssessmentComponent {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  blueprintId String    @map("blueprint_id")
  name        String
  maxMarks    Int       @map("max_marks")
  orderIndex  Int       @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([schoolId])
  @@index([blueprintId])
  @@unique([blueprintId, orderIndex])
  @@map("assessment_components")
}

model SubjectOffering {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  academicYearId String  @map("academic_year_id")
  classId     String    @map("class_id")
  sectionId   String    @map("section_id")
  subjectId   String    @map("subject_id")
  teacherId   String    @map("teacher_id")
  blueprintId String    @map("blueprint_id")
  isElective  Boolean   @default(false) @map("is_elective")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([academicYearId, classId, sectionId, subjectId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([teacherId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@map("subject_offerings")
}

model PromotionRule {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  fromClassId String    @map("from_class_id")
  toClassId   String    @map("to_class_id")
  passMinPercent Int?   @map("pass_min_percent")
  repeatClassId String? @map("repeat_class_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([schoolId, fromClassId])
  @@index([schoolId])
  @@map("promotion_rules")
}
